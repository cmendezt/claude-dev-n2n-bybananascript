# Application
VITE_APP_TITLE={{PROJECT_NAME}}
VITE_APP_DESCRIPTION={{PROJECT_DESCRIPTION}}

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api

# Database (for backend services)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{PROJECT_NAME}}

# Authentication (if using external auth provider)
# VITE_AUTH_DOMAIN=
# VITE_AUTH_CLIENT_ID=

# Feature Flags
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_MOCK_API=false

# Analytics (optional)
# VITE_ANALYTICS_ID=

# Environment
NODE_ENV=development
